    "Capture date and time zone, location, camera details, favorites, hidden state, album placement, Live Photo motion (unless you make them still), HDR, color profile, orientation, and the screenshot tag.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Date de prise de vue et fuseau horaire, lieu, infos de l’appareil, favoris, masquage, albums, mouvement des Live Photos (sauf si vous les rendez fixes), HDR, profil colorimétrique, orientation et étiquette de capture d’écran."
          }
        }
      }
    },
