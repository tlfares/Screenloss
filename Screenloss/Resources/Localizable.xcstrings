    "%lld smaller copies are already in your library. Remove the originals to get %@ back.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld smaller copy is already in your library. Remove the original to get %@ back."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld smaller copies are already in your library. Remove the originals to get %@ back."
