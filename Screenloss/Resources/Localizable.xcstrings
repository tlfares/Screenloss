        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld copie plus légère est déjà dans votre photothèque. Supprimez l’original pour récupérer %@."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld copies plus légères sont déjà dans votre photothèque. Supprimez les originaux pour récupérer %@."
                }
              }
