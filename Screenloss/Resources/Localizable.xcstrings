    "Convert": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertir"
          }
        }
      }
    },
    "Copies are made from the photo as it appears in Photos, edits and Photographic Styles included, and carry over everything iOS lets an app write. Those edits become part of the copy: they can't be reverted afterwards.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies sont faites à partir de la photo telle qu’elle apparaît dans Photos, retouches et Styles photographiques compris, et reprennent tout ce qu’iOS permet à une app d’écrire. Ces retouches font alors partie de la copie : on ne peut plus les annuler ensuite."
          }
        }
      }
    },
    "Copies are saved in your library.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies sont enregistrées dans votre photothèque."
          }
        }
      }
    },
    "Copies saved so far stay in your library, and their originals can still be removed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies déjà enregistrées restent dans votre photothèque, et leurs originaux peuvent toujours être supprimés."
          }
        }
      }
    },
