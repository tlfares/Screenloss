    "%lld%% smaller": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld %% plus léger"
          }
        }
      }
    },
    "1:1": {
      "shouldTranslate": false
    },
    "A copy that isn't at least that much smaller is thrown away and the original stays. Originals are only removed after iOS asks you. Copies Screenloss made start unselected; you can still pick them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une copie qui n’est pas au moins aussi légère est jetée et l’original reste. Les originaux ne sont supprimés qu’après confirmation d’iOS. Les copies faites par Screenloss sont désélectionnées par défaut ; vous pouvez quand même les choisir."
          }
        }
      }
    },
    "A smaller file wasn't possible at this quality.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’obtenir un fichier plus léger à cette qualité."
          }
        }
      }
    },
